# sealed-image — configuration sample.
# Copy to .env and fill in:   cp .env_sample .env   (keep .env out of version control;
# it carries the LUKS passphrase and host-specific values.)
# Every script here sources .env from its own directory.

# ─── identity / secrets ──────────────────────────────────────────────────────
# Public SSH key authorized inside the image: both the initramfs dropbear (to perform
# the attested unlock) and /root/.ssh in the booted OS. Use YOUR key.
SSH_KEY="ssh-ed25519 AAAA... you@host"
# LUKS passphrase for the encrypted root. Released ONLY after attestation passes.
# In production this lives in your key broker / Vault, not on disk.
LUKS_PASS="change-me"

# ─── build host (where sealed_build.sh runs; needs root + spare disk) ─────────
BUILD_DIR="/mnt/Volume-XXXX/build"              # staging (cloud image, STAGE, verify/)
APPNAME="/mnt/Volume-XXXX/sealed-image.img"     # output image (keep on a DIFFERENT disk
                                                # than the flash target, or move before flashing)
CODENAME="resolute"                             # Ubuntu base (26.04 = resolute)
DATA_MB=61440                                   # LUKS data partition MB (OS+driver+engine+weights)
VHASH_MB=1024                                   # dm-verity hash tree MB (~1% of DATA)
CB_MNT="/mnt"                                   # scratch mount base; set to /run on a read-only build host

# ─── optional inputs — the customer's driver / engine / weights ──────────────
# Leave unset for a minimal sealed OS. See README for what to put here.
#DRIVER_COPY=1                                  # copy the GPU driver already on the build host (matching kernel)
#DRIVER_INSTALL_CMD="apt-get install -y nvidia-driver-595-server-open"  # alt: install in the image chroot
#ENGINE_SRC="/mnt/Volume-XXXX/engine"           # daemonless engine payload (store/ cdi/ run.sh storage.conf)
#WEIGHTS_SRC="/mnt/Volume-XXXX/weights"         # model weights -> /opt/weights
#MODEL_MOUNT="/opt/weights"                     # where weights land in the image (default /opt/weights)
ENABLE_SSHD=1                                   # sshd on the RO root via tmpfs host keys (1=yes)
ENABLE_ENGINE_SERVICE=0                         # auto-start the engine at boot (1), or launch it by hand (0)

# ─── measured boot parameters (go into the SNP launch measurement) ───────────
# The kernel cmdline the hypervisor passes. NOTE: no "initrd=initrd" prefix — the host
# adds that to /proc/cmdline but it is NOT part of the measured append. root=UUID must be
# the BOOT partition (BOOT_FS_UUID); the provisioner syncs root= to it on power-on.
CMDLINE="console=ttyS0 root=UUID=3a07f580-a938-4f98-a438-e7449a36ed7a ro net.ifnames=0 biosdevname=0 fsck.mode=auto fsck.repair=yes pci=realloc,nocrs"
BOOT_FS_UUID="3a07f580-a938-4f98-a438-e7449a36ed7a"   # fixed UUID of the image's /boot partition
ESP_VOLID="3DAB345B"                            # fixed FAT volume id of the ESP
HOST_KERNEL="/boot/vmlinuz-7.0.0-38-generic"    # fallback kernel if the cloud image lacks /boot/vmlinuz
ATTEST_PORT=9000                                # port the initramfs serves the SNP report on
#OVMF_PATH="./verify/OVMF.amdsev.fd"            # pinned Verda OVMF for sealed_01_measure.sh

# ─── control host (laptop → instance, for rescue/flash) ──────────────────────
REMOTE="root@<instance-ip>"
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=12"
